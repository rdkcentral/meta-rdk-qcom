From: gokulraj <gokulraj@qti.qualcomm.com>
Date: Mon Jun 3 18:31:21 2024 +0530
Subject: [crashupload]: Added support for Platform IPQ in the uploadDump.sh file
Signed-off-by: gokulraj <gokulraj@qti.qualcomm.com>

---

diff --git a/uploadDumps.sh b/uploadDumps.sh
index 0f57491..1d6011c 100755
--- a/uploadDumps.sh
+++ b/uploadDumps.sh
@@ -82,13 +82,14 @@ if [[ ! -f $CORE_LOG ]]; then
     chmod a+w $CORE_LOG
 fi
 
-#Check for coredump and minidump files
-if [ "$DEVICE_TYPE" = "broadband" ];then
+#As minidumps are not used in BOX_TYPE ipq, skipping it for minidump condition. The core dump files will be handled instead.
+if [ "$DEVICE_TYPE" = "broadband" ] && [ "$BOX_TYPE" != "ipq" ];then
     if [ ! -e $CORE_PATH/*.dmp ]; then exit 0; fi
 else
     if [ ! -e $MINIDUMPS_PATH/*.dmp* -a ! -e $CORE_PATH/*_core*.* ]; then exit 0; fi
 fi
 
+
 if [ -f /lib/rdk/getpartnerid.sh ]; then
     source /lib/rdk/getpartnerid.sh
     partnerId="$(getPartnerId)"
