+saveCoreDump()
+{
+    count=`ls $CORE_PATH | grep ".core.tgz" | wc -l`
+    while [ $count -gt 5 ]; do
+        olddumps=`ls -t $CORE_PATH | grep ".core.tgz" | tail -1`
+        logMessage "Removing old dump $olddumps"
+        rm -rf $CORE_PATH/$olddumps
+        count=`ls $CORE_PATH | grep ".core.tgz" | wc -l`
+    done
+    logMessage "Total pending coredumps : $count"
+}
+
+ipq_upload()
+{
+    local file=$(basename $1)
+
+    count=`find "$WORKING_DIR" -name "$file" | wc -l`
+    if [ $count -eq 0 ]; then logMessage "ERROR:UPLOAD_FAILED:No ${file} for uploading In Dir:${WORKING_DIR}" ; exit 0; fi
+
+    logMessage "Original File Name : $file"
+    logMessage "Value Required for Check : ${file:0:3}"
+    logMessage "ipq_upload $1 and partnerId=$partnerId"
+
+    if [ "${file:0:3}" == "mac" ]; then
+        # Update upload time to corefile from uploadToS3 function.
+        corefiletime=`echo $file | awk -F '_' '{print substr($2,4)}'`
+        logMessage "$DUMP_NAME file timestamp received to upload to HTTP Server: $corefiletime"
+    else
+        # Update upload time to corefile from uploadToS3 function.
+        corefiletime=`echo $file | awk -F '_' '{print substr($3,4)}'`
+        logMessage "$DUMP_NAME file timestamp received to upload to HTTP Server: $corefiletime"
+    fi
+
+    uploadcurtime=`date +%Y-%m-%d-%H-%M-%S`
+    logMessage "$DUMP_NAME file timestamp before upload: $uploadcurtime"
+
+    updatedfile=`echo $file | sed "s/$corefiletime/$uploadcurtime/g"`
+    logMessage "$DUMP_NAME file to be uploaded: `echo $updatedfile`"
+
+    if [ -f $WORKING_DIR"/"$file ]; then
+        logMessage "Renaming the $DUMP_NAME file under $WORKING_DIR"
+        logMessage "mv $WORKING_DIR"/"$file $WORKING_DIR"/"$updatedfile"
+        mv $WORKING_DIR"/"$file $WORKING_DIR"/"$updatedfile
+        IPQ_DUMP_FILENAME=$updatedfile
+        logMessage "IPQ core dump filename to upload : $IPQ_DUMP_FILENAME"
+    else
+        logMessage "$DUMP_NAME file: $file not found under $WORKING_DIR folder..!!!"
+    fi
+
+    count=`find "$WORKING_DIR" -name "$IPQ_DUMP_FILENAME" | wc -l`
+    if [ $count -eq 0 ]; then logMessage "ERROR:UPLOAD_FAILED: ${IPQ_DUMP_FILENAME} not present in dir:${WORKING_DIR} for upload !!" ; exit 0; fi
+
+    crashupload_server_url=`syscfg get crashupload-server-url`
+    if [ "$BOX_TYPE" != "ipq" ]; then
+	cleanup
+    fi
+    
+    logMessage "Attempting crashupload to the the server $crashupload_server_url"
+    if [ "$DEVICE_TYPE" = "broadband" ];then
+    	    ipq_http_upload $IPQ_DUMP_FILENAME
+    fi
+    return $ipq_upload_status
+}
+
+ipq_http_upload()
+{
+	local dump_file=$1
+	crashupload_url=`syscfg get crashupload-server-url`
+	ipq_upload_status=127
+	logMessage "curl -f -X PUT --upload-file "$dump_file" "$crashupload_url""
+	curl -f -X PUT --upload-file "$dump_file" "$crashupload_url"
+	ipq_upload_status=$?
+	if [ $ipq_upload_status -eq 0 ]; then
+		logMessage "Crashupload of $DUMP_NAME to local HTTP server is successful !!"
+	else
+		logMessage "Crashupload of $DUMP_NAME to local HTTP server failed with error code $ipq_upload_status"
+	fi
+	return $ipq_upload_status
