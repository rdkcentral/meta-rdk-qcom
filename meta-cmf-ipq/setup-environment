TOP_DIR=$(pwd)

# default BSP layer is meta-cmf-raspberrypi for IPQ  builds
export RDK_BSP_LAYER=meta-cmf-ipq

if [ -e $TOP_DIR/openembedded-core/bitbake/lib/bb/fetch2/wget.py ]
then
    sed -i 's/wget -t 2 -T 30/wget -t 5 -T 140/g' $TOP_DIR/openembedded-core/bitbake/lib/bb/fetch2/wget.py
fi

if [ -d  $TOP_DIR/meta-cmf ]; then
    source meta-cmf/setup-environment
fi

# at this point the current directory should be the build dir
BUILD_DIR=$(pwd)

if [[ -z $(grep 'meta-cmf-ipq' conf/bblayers.conf) ]] && [[ -d  ../meta-rdk-qcom/meta-cmf-ipq ]]
then
    cat >> conf/bblayers.conf <<EOF
BBLAYERS =+ "\${RDKROOT}/meta-rdk-qcom/meta-cmf-ipq"
EOF
fi

if [[ -z $(grep 'meta-ipq' conf/bblayers.conf) ]] && [[ -d  ../meta-rdk-qcom/meta-ipq ]]
then
    cat >> conf/bblayers.conf <<EOF
BBLAYERS =+ "\${RDKROOT}/meta-rdk-qcom/meta-ipq"
EOF
fi

if [[ -z $(grep 'meta-rdk-opensync' conf/bblayers.conf) ]] && [[ -d  ../meta-rdk-opensync ]]
then
    cat >> conf/bblayers.conf <<EOF
BBLAYERS += "\${@'\${RDKROOT}/meta-rdk-opensync' if os.path.isfile('\${RDKROOT}/meta-rdk-opensync/conf/layer.conf') else ''}"
EOF
fi
