diff --git a/scripts/oemhooks.sh b/scripts/oemhooks.sh
index 3efe9fe..b651ea9 100755
--- a/scripts/oemhooks.sh
+++ b/scripts/oemhooks.sh
@@ -38,6 +38,7 @@ case $BOX_TYPE in
     "SR213") SELFHEAL_TYPE="SYSTEMD";;
     "WNXL11BWL") SELFHEAL_TYPE="SYSTEMD";;
     "VNTXER5") SELFHEAL_TYPE="SYSTEMD";;
