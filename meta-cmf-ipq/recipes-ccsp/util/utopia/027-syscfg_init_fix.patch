 #include "syscfg.h"       // external interface used by users
 #include "safec_lib_common.h"
 
+#include <stdbool.h>
+#include <time.h>
+#include <stdarg.h>
+#include <sys/stat.h>
+
+#define SYSCFG_DBG_FILE "/tmp/syscfg_tmp.dbg"
+#define SYSCFG_LOG_FILE0 "/tmp/syscfg_lib.log.0"
+#define SYSCFG_LOG_FILE1 "/tmp/syscfg_lib.log.1"
+#define SYSCFG_LOG_FILE_SIZE (2*1024*1024)
+
+typedef enum
+{
+    SYSCFG_VERBOSE = 0,
+    SYSCFG_DBG = 1,
+    SYSCFG_INFO = 2,
+    SYSCFG_ERR = 3,
+}SYSCFG_LOG_LEVEL;
+
+
+static int get_formatted_time(char *time)
+{
+    struct tm *tm_info;
+    struct timeval tv_now;
+    char tmp[128];
+
+    gettimeofday(&tv_now, NULL);
+    tm_info = localtime(&tv_now.tv_sec);
+    strftime(tmp, 128, "%y%m%d-%T", tm_info);
+    snprintf(time, 128, "%s.%06d", tmp, (int)tv_now.tv_usec);
+    return 0;
+}
+
+static void syscfg_logger(char *buffer)
+{
+    char time[128] = {0};
+    FILE *fp_log = NULL;
+    struct stat st;
+    int ret = 0;
+
+    stat(SYSCFG_LOG_FILE0, &st);
+    if(st.st_size >= SYSCFG_LOG_FILE_SIZE)
+    {
+        rename(SYSCFG_LOG_FILE0, SYSCFG_LOG_FILE1);
+        fp_log = fopen(SYSCFG_LOG_FILE0, "w");
+    }
+    else
+    {
+        fp_log = fopen(SYSCFG_LOG_FILE0, "a+");
+    }
+    if (fp_log == NULL)
+    {
+        return;
+    }
+
+    ret = get_formatted_time(time);
+    if(ret != 0)
+    {
+        fprintf(fp_log, "Couldnot fetch the time.");
+    }
+    fprintf(fp_log, "%s: [syscfg_lib] ", time);
+    fprintf(fp_log, "%s\n", buffer);
+    fclose(fp_log);
+}
+
+static void syscfg_dbg_print(int level, char *format, ...)
+{
+    char buffer[4096] = {0};
+    va_list list;
+    FILE *fp_dbg = NULL;
+    int stored_level;
+
+    va_start(list, format);
+    vsnprintf(buffer, sizeof(buffer), format, list);
+    va_end(list);
+
+    fp_dbg = fopen(SYSCFG_DBG_FILE, "r");
+    if(fp_dbg == NULL)
+    {
+        if(level >= SYSCFG_INFO)
+        {
+            syscfg_logger(buffer);
+        }
+    }
+    else
+    {
+        fscanf(fp_dbg, "%d", &stored_level);
+        fclose(fp_dbg);
+        if(level >= stored_level)
+        {
+            syscfg_logger(buffer);
+        }
+    }
+}
+
