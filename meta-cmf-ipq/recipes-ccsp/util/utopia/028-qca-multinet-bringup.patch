+extern token_t sysevent_token_interactive;
+
+int configVlan_WiFi(PSWFabHALArg args, int numArgs, BOOL up) 
+{
+    int i;
+    char portID[80];
+    memset(portID, 0, 80);
+    errno_t  rc = -1;
+
+    for (i = 0; i < numArgs; ++i ) 
+    { 
+        rc = strcat_s(portID, sizeof(portID), (char*)args[i].portID);
+        ERR_CHK(rc);
+        if (args[i].vidParams.tagging){
+            rc = strcat_s(portID, sizeof(portID), "-t");
+            ERR_CHK(rc);
+        }
+        if (i < (numArgs - 1)){
+            rc = strcat_s(portID, sizeof(portID), " ");
+            ERR_CHK(rc);
+        }
+    }
+  
+    MNET_DEBUG("configVlan_WiFi, portId is:%s command is %s %s %d %d \"%s\"" COMMA portID COMMA SERVICE_MULTINET_DIR "/handle_wifi.sh" COMMA up ? "addVlan" : "delVlan" COMMA
+                        args[0].hints.network->inst COMMA args[0].vidParams.vid COMMA portID);
+    v_secure_system(SERVICE_MULTINET_DIR "/handle_wifi.sh %s %d %d '%s'",up ? "addVlan" : "delVlan",
+                        args[0].hints.network->inst, args[0].vidParams.vid, portID);
+    return 0;
+}
+
+/* Helper function to add/remove interfaces to/from bridges */
+int portHelper(char *bridge, char *port, int tagging, int vid, BOOL up)
+{
+    int rc;
+    int result = 0;
+
+    MNET_DEBUG("portHelper, bridge=%s, port=%s, tagging=%d, vid=%d, up=%d\n" COMMA
+               bridge COMMA port COMMA tagging COMMA vid COMMA up);
+
+    if (up) {
+        // Verify interface exists
+        rc = v_secure_system("ip link show %s >/dev/null 2>&1", port);
+        if (rc != 0) {
+            MNET_DEBUG("portHelper: Interface %s does not exist (rc=%d)\n" COMMA port COMMA rc);
+            return -1;
+        }
+
+        // Bring up the interface
+        rc = v_secure_system("ifconfig %s up", port);
+        if (rc != 0) {
+            MNET_DEBUG("portHelper: Failed to bring up %s (rc=%d)\n" COMMA port COMMA rc);
+            result = -1;
+        }
+
+        // If already enslaved to some bridge, detach before adding to target
+        rc = v_secure_system(
+            "sh -c 'if [ -e /sys/class/net/%s/brport/bridge ]; then "
+            "br=$(basename $(readlink /sys/class/net/%s/brport/bridge)); "
+            "[ \"$br\" != \"%s\" ] && brctl delif \"$br\" \"%s\"; "
+            "fi'",
+            port, port, bridge, port);
+        if (rc != 0) {
+            // Not fatal; just log. This may return non-zero if not enslaved or if delif fails.
+            MNET_DEBUG("portHelper: Detach check/delif for %s returned rc=%d\n" COMMA port COMMA rc);
+        }
+
+        // Add interface to target bridge
+        rc = v_secure_system("brctl addif %s %s", bridge, port);
+        if (rc == 0) {
+            MNET_DEBUG("portHelper: Added %s to bridge %s\n" COMMA port COMMA bridge);
+        } else {
+            MNET_DEBUG("portHelper: FAILED to add %s to bridge %s (rc=%d)\n" COMMA port COMMA bridge COMMA rc);
+            result = -1;
+        }
+    } else {
+        // Remove interface from bridge
+        rc = v_secure_system("brctl delif %s %s", bridge, port);
+        if (rc == 0) {
+            MNET_DEBUG("portHelper: Removed %s from bridge %s\n" COMMA port COMMA bridge);
+        } else {
+            MNET_DEBUG("portHelper: FAILED to remove %s from bridge %s (rc=%d)\n" COMMA port COMMA bridge COMMA rc);
+            result = -1;
+        }
+    }
+
+    return result;
+}
+
+/* Function to handle Ethernet interfaces */
+int configVlan_ETH(PSWFabHALArg args, int numArgs, BOOL up)
+{
+    int i;
+
+    for (i = 0; i < numArgs; ++i) {
+        const char *port = (const char *)args[i].portID;
+        portHelper(args[i].hints.network->name, (char *)port, args[i].vidParams.tagging, args[i].vidParams.vid, up);
+    }
+
+    return 0;
+}
