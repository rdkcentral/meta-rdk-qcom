From: sanknata <sanknata@qti.qualcomm.com>
Date: Thu Jan 2 12:24:11 2025 +0530
Subject: Reason for change : To remove sed commands used in utopia.bbappend
Signed-off-by: sanknata <sanknata@qti.qualcomm.com>
-----------------------------------

diff --git a/source/scripts/init/system/utopia_init.sh b/source/scripts/init/system/utopia_init.sh
index 32ab244..1b0aead 100755
--- a/source/scripts/init/system/utopia_init.sh
+++ b/source/scripts/init/system/utopia_init.sh
@@ -45,6 +45,15 @@ CCSPPATH="/usr/ccsp"
 ls /tmp/pam_initialized* > /tmp/pam_init_status
 
 source $UTOPIA_PATH/log_capture_path.sh
+mkdir -p /nvram
+touch /nvram/rbus_support utopia_init.sh
+rm -f /nvram/dnsmasq.leases
+cp /usr/ccsp/ccsp_msg.cfg /tmp
+touch /tmp/cp_subsys_ert
+ln -s /var/spool/cron/crontabs /
+mkdir -p /var/run/firewall
+mkdir -p /opt/secure
+touch /nvram/ETHWAN_ENABLE
 source /etc/device.properties
 
 dmesg -n 5
@@ -443,6 +452,7 @@ syseventd
 sleep 1 
 echo_t "[utopia][init] Setting any unset system values to default"
 apply_system_defaults
+/usr/bin/apply_board_defaults.sh
 changeFilePermissions $SYSCFG_BKUP_FILE 400
 if [ "$ENCRYPT_SYSCFG" = false ] ; then
    echo "[utopia][init] SEC: Syscfg stored in $SYSCFG_BKUP_FILE"
@@ -704,7 +714,7 @@ else
       fi
 fi
 
-if [ "$MODEL_NUM" = "DPC3939B" ] || [ "$MODEL_NUM" = "DPC3941B" ]; then
+if [ "$MODEL_NUM" = "DPC3939B" ] || [ "$MODEL_NUM" = "DPC3941B" ] || [ "$BOX_TYPE" = "ipq" ]; then
     if [ -f /nvram/restore_reboot ];then
 	syscfg set X_RDKCENTRAL-COM_LastRebootReason "restore-reboot"
 	syscfg set X_RDKCENTRAL-COM_LastRebootCounter "1"
@@ -726,6 +736,8 @@ if [ "$MODEL_NUM" = "DPC3939B" ] || [ "$MODEL_NUM" = "DPC3941B" ]; then
     rm -f /nvram/restore_reboot
     rm -f /nvram/bbhm_bak_cfg.xml.prev
     rm -f /nvram/syscfg.db.prev
+    rm -f /nvram/hostapd0.conf.prev
+    rm -f /nvram/hostapd1.conf.prev
 fi
 
 CBF_Defaulted=`syscfg get CodeBigFirstDefaulted`
@@ -773,9 +785,21 @@ syscfg set ntp_status 2
 echo_t "[utopia][init] setting Multicast MAC before any switch configs"
 $UTOPIA_PATH/service_multinet_exec set_multicast_mac &
 
-if [ "$MODEL_NUM" = "DPC3939B" ] || [ "$MODEL_NUM" = "DPC3941B" ]; then
+if [ "$MODEL_NUM" = "DPC3939B" ] || [ "$MODEL_NUM" = "DPC3941B" ] || [ "$BOX_TYPE" = "ipq" ]; then
 	echo_t "[utopia][init] started dropbear process"
 	/etc/utopia/service.d/service_sshd.sh sshd-start &
+#TODO: Need to replaced once the sky version 2 code is available
+sysevent set lan-start 0
+sysevent set bridge-stop 0
+sysevent set bridge_mode 0
+sysevent set dhcp_server-resync 0
+sysevent set ethwan-initialized 1
+syscfg set eth_wan_enabled true
+syscfg commit
+ln -s /etc/dibbler /tmp
+#To avoid sigsegv crash with dibbler-client
+touch /etc/dibbler/radvd.conf
+echo 1 > /proc/sys/net/ipv4/ip_forward
 fi
 
 
