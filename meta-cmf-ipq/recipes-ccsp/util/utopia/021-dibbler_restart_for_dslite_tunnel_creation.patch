Index: git/source/scripts/init/service.d/service_wan.sh
===================================================================
--- git.orig/source/scripts/init/service.d/service_wan.sh
+++ git/source/scripts/init/service.d/service_wan.sh
@@ -81,6 +81,12 @@ SERVICE_NAME=wan
 case "$1" in
     "${SERVICE_NAME}-start")
         nice -n -5 service_wan start
+        DSLITE_ENABLED=`syscfg get dslite_enable`
+        if [ "x1" = "x$DSLITE_ENABLED" ]; then
+            service_dslite start
+            dibbler-client stop
+            dibbler-client start
+        fi
         ;;
     "${SERVICE_NAME}-stop")
         service_wan stop
