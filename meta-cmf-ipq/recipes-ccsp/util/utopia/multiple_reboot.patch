From: krisa <krisa@qti.qualcomm.com>
Date: Mon Aug 14 17:31:32 2023 +0530
Subject: Fix for Bridge_port Lan inteface
Signed-off-by: krisa <krisa@qti.qualcomm.com>

---

diff --git a/source/scripts/init/service.d/service_lan.sh b/source/scripts/init/service.d/service_lan.sh
index 3f15088..4f6de16 100755
--- a/source/scripts/init/service.d/service_lan.sh
+++ b/source/scripts/init/service.d/service_lan.sh
@@ -675,6 +675,16 @@ service_start ()
 #   echo "lan service start called" > /dev/console
 #song:   register_docsis_handler
    wait_till_end_state ${SERVICE_NAME}
+   STATUS=`sysevent get ${SERVICE_NAME}-status`
+   if [ "$STATUS" == "started" ] ; then
+      IF_NAMES=`syscfg get lan_ethernet_physical_ifnames`
+      for var in $IF_NAMES; do
+              CURR_STATUS=`ifconfig $var | grep UP | awk '{print $1}'`
+              if [ "$CURR_STATUS" != "UP" ] ; then
+                 sysevent set ${SERVICE_NAME}-status error
+              fi
+      done
+   fi
 
    STATUS=`sysevent get ${SERVICE_NAME}-status`
    if [ "started" != "$STATUS" ] ; then
@@ -718,7 +728,7 @@ service_stop ()
 {
    wait_till_end_state ${SERVICE_NAME}
 
-   STATUS=`sysevent get ${SERVICE_NAME}-status` 
+   STATUS=`sysevent get ${SERVICE_NAME}-status`
    if [ "stopped" != "$STATUS" ] ; then
       sysevent set ${SERVICE_NAME}-errinfo
       sysevent set ${SERVICE_NAME}-status stopping
@@ -733,9 +743,13 @@ service_stop ()
       elif [ "" = "$SYSCFG_lan_dhcp_client" -o "0" = "$SYSCFG_lan_dhcp_client" ] ; then
          sysevent set ${SERVICE_NAME}-errinfo
          sysevent set ${SERVICE_NAME}-status stopped
+         TEMP=`sysevent get ${SERVICE_NAME}-status`
+         if [ "stopped" != "$TEMP" ] ; then
+            sysevent set ${SERVICE_NAME}-status error
+         fi
       fi
 	  #unregister wecb_master from pmon to let this script to bring it up when lan restart.
-	  /etc/utopia/service.d/pmon.sh unregister wecb_master 
+	  /etc/utopia/service.d/pmon.sh unregister wecb_master
 	  #rongwei added
 #	  killall wecb_master 2>/dev/null
 	  killall CcspHomeSecurity 2>/dev/null
@@ -778,8 +792,7 @@ register_docsis_handler () {
 # ENTRY
 #------------------------------------------------------------------
 
-service_init 
-
+service_init
 case "$1" in
    "${SERVICE_NAME}-start")
       service_start
@@ -791,6 +804,10 @@ case "$1" in
       echo "service_init : setting lan-restarting to 1"
       sysevent set lan-restarting 1
       service_stop
+      VAR=`sysevent get ${SERVICE_NAME}-status`
+      if [ "started" == "$VAR" ] ; then
+         sysevent set ${SERVICE_NAME}-status error
+      fi
       service_start
       echo "service_init : setting lan-restarting to 0"
       sysevent set lan-restarting 0
@@ -816,7 +833,7 @@ case "$1" in
          # For USGv2 Only: allow LAN site access to CM Diagnostic IP 192.168.100.1
       add_docsis_bridge
       ;;
-   *)   
+   *)
       echo "Usage: service-${SERVICE_NAME} [ ${SERVICE_NAME}-start | ${SERVICE_NAME}-stop | ${SERVICE_NAME}-restart]" > /dev/console
       exit 3
       ;;
