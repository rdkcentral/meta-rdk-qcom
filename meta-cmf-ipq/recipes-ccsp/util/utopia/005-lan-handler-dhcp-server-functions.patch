       fi
    fi

-   if [ "$BOX_TYPE" = "rpi" ] || [ "$BOX_TYPE" = "turris" ]; then
           LAN_STATUS=`sysevent get lan-status`
           BRIDGE_MODE=`syscfg get bridge_mode`
           if [ "$LAN_STATUS" = "stopped" ] && [ $BRIDGE_MODE == 0 ]; then
                   echo_t "DHCP_SERVER : Starting lan-status"
