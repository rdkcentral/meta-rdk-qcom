    if [ "started" = "$CURRENT_LAN_STATE" ]; then
       calculate_dhcp_range "$LAN_IPADDR" "$LAN_NETMASK"
       echo "interface=$LAN_IFNAME" >> $LOCAL_DHCP_CONF
