diff --git a/source/scripts/init/service.d/lan_handler.sh b/source/scripts/init/service.d/lan_handler.sh
index 0001b6cf9..ff24487ad 100755
--- a/source/scripts/init/service.d/lan_handler.sh
+++ b/source/scripts/init/service.d/lan_handler.sh
@@ -296,6 +296,20 @@ case "$1" in
             sysevent set multinet-up 9
         fi

+        PHY_BRIDGE_IFNAME=`syscfg get lan_ifname`
+        LAN_IP=`syscfg get lan_ipaddr`
+        LAN_NETMASK=`syscfg get lan_netmask`
+        ifconfig $PHY_BRIDGE_IFNAME $LAN_IP netmask $LAN_NETMASK
+        PHY_ETH_IFNAMES=`syscfg get lan_ethernet_physical_ifnames`
+        IFS=' ' read -r -a PHY_ETH_IFNAME_ARRAY <<< "$PHY_ETH_IFNAMES"
+        for PHY_ETH_IFNAME in "${PHY_ETH_IFNAME_ARRAY[@]}"
+        do
+            echo "LAN HANDLER : PHY_ETH_IFNAME = $PHY_ETH_IFNAME"
+            ifconfig $PHY_ETH_IFNAME up
+            brctl addif $PHY_BRIDGE_IFNAME $PHY_ETH_IFNAME
+        done
+
+
         echo_t "LAN HANDLER : Triggering RDKB_FIREWALL_RESTART after nfqhandler"
        t2CountNotify "RF_INFO_RDKB_FIREWALL_RESTART"
         sysevent set firewall-restart
@@ -387,14 +387,11 @@ case "$1" in
                 sysevent set homesecurity_lan_l3net ${HSINST}
                 sysevent set primary_lan_l3net ${INST}
 	#BRLAN0 ISSUE : Manually invoking lan-start to fix brlan0 failure during intial booting. Root cause for event has to be identified
-	   	if [ "$RPI_SPECIFIC" = "rpi" ]; then
-        		        sleep 2
-                                L3NET=`sysevent get primary_lan_l3net`
-                                if [ -z "$L3NET" ]; then
-                                     L3NET=4
-                                     sysevent set primary_lan_l3net $L3NET
-                                fi
-                fi
+                L3NET=4
+                sysevent set primary_lan_l3net $L3NET
+                #sleep 10
+                /etc/utopia/service.d/service_lan.sh lan-start
+                
 	elif [ "$BOX_TYPE" = "TCCBR" ]; then
 		if [ -z "$INST" ]; then
 			echo "*****SET THE PRIMARY LAN ******" > /dev/null
diff --git a/source/scripts/init/service.d/service_dhcp_server/dhcp_server_functions.sh b/source/scripts/init/service.d/service_dhcp_server/dhcp_server_functions.sh
