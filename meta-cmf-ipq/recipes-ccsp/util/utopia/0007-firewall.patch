+#if defined(_PLATFORM_IPQ_)
+int do_add_pppoe_rule(FILE *filter_fp, FILE *nat_fp)
+{
+    int enable = 0;
+    char query[MAX_QUERY] = {0};
+    syscfg_get(NULL, "pppoe_enable", query, sizeof(query));
+    if (query[0] != '\0')
+    {
+        enable = atoi(query);
+    }
+
+    if (enable)
+    {
+        FILE *f;
+        char *context = NULL;
+        char source_addr[20];
+        char dest_addr[20];
+        char cmd_buff[100];
+
+        snprintf(cmd_buff, sizeof(cmd_buff), "ip addr show ppp0|grep -w inet|cut -d/ -f1| cut -d ' ' -f6| sed '1q;d'");
+        f = popen(cmd_buff, "r");
+        if (f == NULL)
+        {
+            printf("Failed to run command\n");
+            return 0;
+        }
+
+        fgets(source_addr, 20, f);
+        strtok_r(source_addr, "\n", &context);
+        pclose(f);
+        snprintf(cmd_buff, sizeof(cmd_buff), "ip addr show ppp0|grep -w peer|cut -d/ -f1| cut -d ' ' -f8|sed '1q;d'");
+        f = popen(cmd_buff, "r");
+        if (f == NULL)
+        {
+            printf("Failed to run command\n");
+            return 0;
+        }
+
+        fgets(dest_addr, 20, f);
+        strtok_r(dest_addr, "\n", &context);
+        pclose(f);
+
+        fprintf(nat_fp, "-A PREROUTING -i ppp0 -j DNAT --to-destination %s\n", dest_addr);
+        fprintf(nat_fp, "-A POSTROUTING -o ppp0 -j SNAT --to-source %s\n", source_addr);
+        fprintf(nat_fp, "-A POSTROUTING -o ppp0 -j MASQUERADE\n");
+        fprintf(filter_fp, "-A FORWARD -i brlan0 -o ppp0 -j ACCEPT\n");
+        fprintf(filter_fp, "-A FORWARD -i erouter0 -o ppp0 -j ACCEPT\n");
+
+        syscfg_set(NULL, "pppoe_enable", "0");
+    }
+    return 0;
+}
+#endif
