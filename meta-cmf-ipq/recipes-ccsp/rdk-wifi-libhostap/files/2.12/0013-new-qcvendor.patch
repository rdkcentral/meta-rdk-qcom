Index: hostap-2.12/src/drivers/drivers.c
===================================================================
--- hostap-2.12.orig/src/drivers/drivers.c
+++ hostap-2.12/src/drivers/drivers.c
@@ -10,6 +10,18 @@
 #include "utils/common.h"
 #include "driver.h"
 
+/* Global function pointer variables for event dispatch.
+ * In AP mode (hostapd), these are assigned to hostapd_event / hostapd_event_global
+ * in hostapd/main.c.  In STA mode (wpa_supplicant), they are assigned to
+ * supplicant_event / supplicant_event_global in wpa_supplicant/wpa_supplicant.c.
+ * This mirrors the QCA UD hostapd 2.11 approach and allows both
+ * wpa_supplicant/events.o and src/ap/drv_callbacks.o to coexist in libhostap.so
+ * without a multiple-definition linker error.
+ */
+void (*wpa_supplicant_event)(void *ctx, enum wpa_event_type event,
+			     union wpa_event_data *data);
+void (*wpa_supplicant_event_global)(void *ctx, enum wpa_event_type event,
+				    union wpa_event_data *data);
 
 const struct wpa_driver_ops *const wpa_drivers[] =
 {
