Index: hostap-2.12/hostapd/main.c
===================================================================
--- hostap-2.12.orig/hostapd/main.c
+++ hostap-2.12/hostapd/main.c
@@ -34,6 +34,17 @@
 #include "ctrl_iface.h"
 
 
+/* Forward declarations for event dispatch functions defined in
+ * src/ap/drv_callbacks.c.  These are assigned to the wpa_supplicant_event /
+ * wpa_supplicant_event_global function pointers so that the AP-mode event
+ * handler is used when running as hostapd.
+ * Named hostapd_wpa_event / hostapd_wpa_event_global to match QCA UD
+ * hostapd 2.11 naming convention (hostapd/main.c:796). */
+void hostapd_wpa_event(void *ctx, enum wpa_event_type event,
+		       union wpa_event_data *data);
+void hostapd_wpa_event_global(void *ctx, enum wpa_event_type event,
+			      union wpa_event_data *data);
+
 struct hapd_global {
 	void **drv_priv;
 	size_t drv_count;
@@ -966,6 +977,8 @@ int main(int argc, char *argv[])
 		usage();
 
 	wpa_msg_register_ifname_cb(hostapd_msg_ifname_cb);
+	wpa_supplicant_event = hostapd_wpa_event;
+	wpa_supplicant_event_global = hostapd_wpa_event_global;
 
 	if (log_file)
 		wpa_debug_open_file(log_file);
