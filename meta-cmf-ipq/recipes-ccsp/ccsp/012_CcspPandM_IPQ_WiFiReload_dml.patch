+BOOL
+IPQ_WiFiReload_SetParamBoolValue
+(ANSC_HANDLE hInsContext,
+ char* ParamName,
+ BOOL bValue
+ )
+{
+    if (strcmp(ParamName, "Enable") == 0) {
+      //Restart rdk_qca_wifi.sh script
+      system("sh /usr/bin/rdk_qca_wifi.sh restart &");
+      return TRUE;
+    }
+
+    else if (strncmp(ParamName, "MAP_Agent_reload", strlen(ParamName)) == 0) {
+      //Restart ezmesh and wsplcd service
+      system("wifi_api qca_mapAgentRestart &");
+      return TRUE;
+    }
+
+    return FALSE;
+}
