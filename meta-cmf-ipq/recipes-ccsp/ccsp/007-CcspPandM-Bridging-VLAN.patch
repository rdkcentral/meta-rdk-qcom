+ANSC_STATUS
+CosaDmlBrgVlanAddEntryHAL
+    (
+        PCOSA_DML_BRG_FULL_ALL         pDmlBridge,
+        ULONG                       ulBrgInstanceNumber,
+        PCOSA_DML_BRG_VLAN_FULL     pEntry
+    )
+{
+	char buf[512];
+	PBRIDGE pBridge = getBridge(ulBrgInstanceNumber);
+
+	if (pBridge == NULL) {
+		return ANSC_STATUS_CANT_FIND;
+	}
+	sprintf_s(buf,sizeof(buf),"%d",pEntry->Cfg.VLANID);
+	vlan_hal_addGroup(pDmlBridge->Cfg.Alias,buf);
+	return ANSC_STATUS_SUCCESS;
+}
