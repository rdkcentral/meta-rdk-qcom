+ANSC_STATUS
+CosaDmlBrgPortAddEntryHAL
+            (
+                 PCOSA_DML_BRG_FULL_ALL         pDmlBridge,
+                ULONG                       ulBrgInstanceNumber,
+                PCOSA_DML_BRG_PORT_FULL      pEntry
+            )
+{
+	AnscTraceFlow((" %s \n",__FUNCTION__));
+	char buf[512];
+	errno_t rc      = -1;
+	PBRIDGE pBridge = getBridge(ulBrgInstanceNumber);
+	if (pBridge == NULL) {
+		AnscTraceFlow(("<HL>%s  cannot find the birdge inst=%lu\n",__FUNCTION__,ulBrgInstanceNumber ));
+		return ANSC_STATUS_CANT_FIND;
+	}
+	PBRIDGE_PORT pBPort = getBPort(pBridge, pEntry->Cfg.InstanceNumber);
+	if (pBPort == NULL) {
+		AnscTraceFlow(("<HL> %s cannot find port inst=%lu\n",__FUNCTION__,pEntry->Cfg.InstanceNumber));
+		return ANSC_STATUS_CANT_FIND;
+	}
+	sprintf_s(buf,sizeof(buf),"%d",pEntry->Cfg.PVID);
+	if ( ulBrgInstanceNumber == 1 )
+	{
+		add_primary_interfaces(pDmlBridge->Cfg.Alias,pEntry->Info.Name,buf);
+	}
+	else
+	{
+
+		vlan_hal_addInterface(pDmlBridge->Cfg.Alias,pEntry->Info.Name,buf);
+	}
+	return ANSC_STATUS_SUCCESS;
+}
