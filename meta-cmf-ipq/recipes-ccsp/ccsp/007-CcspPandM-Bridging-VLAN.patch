+PBRIDGE_VLAN_VLANID getBVlanid(PBRIDGE pBridge, ULONG ulInstanceNumber)
+{
+    PBRIDGE_VLAN_VLANID curVlanVlanid = (PBRIDGE_VLAN_VLANID) AnscSListGetFirstEntry(&pBridge->vlanList);
+    AnscTraceFlow(("<HL> %s \n",__FUNCTION__));
+    while (curVlanVlanid != NULL) {
+        if (curVlanVlanid->instanceNumber == ulInstanceNumber) {
+
+            return curVlanVlanid;
+        }
+        curVlanVlanid = (PBRIDGE_VLAN) curVlanVlanid->Linkage.Next;
+    }
+    //$HL 4/26/2013
+    AnscTraceFlow(("<HL> %s new struct  bVlanid not found, bridge instanceNumber=%lu port instanceNumber=%lu\n",
+        __FUNCTION__, pBridge->instanceNumber,ulInstanceNumber));
+    return NULL;
+}
