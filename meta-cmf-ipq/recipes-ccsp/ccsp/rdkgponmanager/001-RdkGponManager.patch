 {
     GPON_DML_DATA* pDmlData = GponMgrDml_GetData();

+    if (ijsonrpcbuginevent==1)
+    {
+        if (ijsonrpcbug==1)
+        {
+            ijsonrpcbuginevent=0;
+           CcspTraceInfo(("Mutex lock was already acquired. So skipping Event request to avoid race condition(deadlock situation)\n"));
+            return NULL;
+        }
+    }
+
     if(pDmlData != NULL)
     {
         if(pthread_mutex_lock(&(pDmlData->mDataMutex)) == 0)
         {
+           ijsonrpcbug=1;
             return pDmlData;
         }
     }
@@ -45,6 +56,7 @@ void GponMgrDml_GetData_release(GPON_DML_DATA* pDmlData)
 {
     if(pDmlData != NULL)
     {
+       ijsonrpcbug=0;
         pthread_mutex_unlock (&(pDmlData->mDataMutex));
     }
 }
