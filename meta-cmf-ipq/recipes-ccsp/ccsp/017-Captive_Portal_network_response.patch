Subject: Captive portal Redirection Handling
Signed-off-by: rajka <rajka@qti.qualcomm.com>

---

diff --git a/arch/intel_usg/boards/arm_shared/scripts/network_response.sh b/arch/intel_usg/boards/arm_shared/scripts/network_response.sh
index f366043..9fac820 100644
--- a/arch/intel_usg/boards/arm_shared/scripts/network_response.sh
+++ b/arch/intel_usg/boards/arm_shared/scripts/network_response.sh
@@ -643,7 +643,7 @@ then
                 echo_t "Network Response: NotifyWiFiChanges is $SET_CONFIGURE_FLAG"
                 echo_t "Network Response: Redirection_flag value is $REDIRECTION_FLAG"
 
-                if [ "$NETWORKRESPONSEVALUE" = "204" ] && [ "$SET_CONFIGURE_FLAG" = "true" ]
+                if [ "$NETWORKRESPONSEVALUE" = "204" ] && [ "$SET_CONFIGURE_FLAG" = "true" ] || [ "$SET_CONFIGURE_FLAG" = "TRUE" ]
                 then
                     count=0
                     MaxCount=30
--- a/arch/intel_usg/boards/arm_shared/scripts/revert_redirect.sh  2023-10-27 15:39:13.894860440 +0530
+++ b/arch/intel_usg/boards/arm_shared/scripts/revert_redirect.sh      2023-10-27 15:34:28.524973781 +0530
@@ -39,7 +39,7 @@
 then
     echo_t "Revert Redirect : Reverting back the changes made for redirecting the URL's"
     syscfg set redirection_flag false
-
+    syscfg set CaptivePortal_Enable false
     # Check if command execution was success
     # If not, set syscfg value once again
     result=`echo $?`
@@ -47,6 +47,7 @@
     then
         echo_t "Revert Redirect : Setting redirection_flag to false failed, try resetting it.."
         syscfg set redirection_flag false
+       syscfg set CaptivePortal_Enable false
     fi

     syscfg commit
@@ -203,6 +204,7 @@
     then
         echo_t "Revert Redirect : Setting redirection_flag to false failed even after retry, trying to reset it again.."
         syscfg set redirection_flag false
+       syscfg set CaptivePortal_Enable false
         syscfg commit
     fi
