+ANSC_STATUS CosaDmlUpdateBrgIfaceWiFi(int apIndex, char* BridgeName)
+{
+      CCSP_MESSAGE_BUS_INFO *bus_info = (CCSP_MESSAGE_BUS_INFO *)bus_handle;
+      fprintf(stderr, "WiFi hostapd file update\n");
+      CcspTraceInfo(("Update Hostapd,RELOAD AP\n"));
+      int                         ret;
+      int                         size = 0;
+      componentStruct_t **        ppComponents = NULL;
+      char paramname[1024]= {0};
+      char*   faultParam = NULL;
+      char   dst_pathname_cr[64]  =  {0};
+      //AssociatedBridgeInterface
+      snprintf(paramname,sizeof(paramname),"Device.WiFi.AccessPoint.%d.BridgingHostapd",(apIndex+1));
+      snprintf(dst_pathname_cr,sizeof(dst_pathname_cr),"%s%s", g_Subsystem, CCSP_DBUS_INTERFACE_CR);
+
+      CcspTraceInfo(("  Value of param stored for IPC %s value of index %d and bridge name %s\n", paramname, apIndex+1,BridgeName));
+      ret = CcspBaseIf_discComponentSupportingNamespace(bus_handle,
+                      dst_pathname_cr,
+                      paramname,
+                      g_Subsystem,        /* prefix */
+                      &ppComponents,
+                      &size);
+
+      if ( ret == CCSP_SUCCESS && size == 1)
+      {
+              parameterValStruct_t val[1] = { { paramname,BridgeName, ccsp_string}};
+
+              ret = CcspBaseIf_setParameterValues
+                      (
+                       bus_handle,
+                       ppComponents[0]->componentName,
+                       ppComponents[0]->dbusPath,
+                       0, 0x0,   /* session id and write id */
+                       &val,
+                       //                                      2,
+                       1,
+                       TRUE,   /* no commit */
+                       &faultParam
+                      );
+
+              if (ret != CCSP_SUCCESS && faultParam)
+              {
+                      CcspTraceInfo((" %s Failed to SetValue for param '%s'\n",__FUNCTION__,faultParam));
+                      bus_info->freefunc(faultParam);
+              } else {
+
+                       CcspTraceInfo((" %s success to SetValue for param '%s'\n",__FUNCTION__,faultParam));
+                        return ANSC_STATUS_SUCCESS;
+              }
+      }
+
+      return ANSC_STATUS_FAILURE;
+}
