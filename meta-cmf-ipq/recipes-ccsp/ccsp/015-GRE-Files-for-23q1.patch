+ANSC_STATUS
+CosaLoadBridgeGreInf()
+{
+       int retPsmGet = CCSP_SUCCESS;
+       int retPsmGet1 = CCSP_SUCCESS;
+       int retPsmGet2 = CCSP_SUCCESS;
+       char *param_value = NULL,*brg_name = NULL,*port_name=NULL,*port_pvid=NULL;
+       char param_name[256]= {0};
+       unsigned int brCnt = 0,portCnt =0;
+       unsigned  int *brList = NULL, *portList = NULL;
+       unsigned int i = 0, j=0;
+       errno_t rc = -1;
+
+       retPsmGet1 = PsmGetNextLevelInstances(bus_handle, g_Subsystem, DMSB_L2_PREFIX, &brCnt, &brList);
+       if ( retPsmGet2 == CCSP_SUCCESS )
+       {
+               for(i = 1; i <= brCnt; i++)
+               {
+                       _PSM_GET_BRIDGE_NAME;
+                       _ansc_memset(param_name, 0, sizeof(param_name));
+                       rc = sprintf_s(param_name, sizeof(param_name), DMSB_L2_BPORT_PREFIX,i) ;
+                       if(rc < EOK)
+                       {
+                              ERR_CHK(rc);
+                      }
+                       retPsmGet2 = 0;
+                       retPsmGet2 = PsmGetNextLevelInstances(bus_handle, g_Subsystem, param_name, &portCnt, &portList);
+                       if ( retPsmGet2 == CCSP_SUCCESS )
+                       {
+                              for( j=1; j <= portCnt; j++)
+                             {
+                                       _PSM_GET_PORT_NAME;
+                                       _PSM_GET_PORT_PVID;
+                                       if (!strcmp(brg_name , "brlan0") )
+                                       {
+                                               add_primary_interfaces(brg_name,port_name,port_pvid);
+                                               ((CCSP_MESSAGE_BUS_INFO *)bus_handle)->freefunc(port_name);
+                                               ((CCSP_MESSAGE_BUS_INFO *)bus_handle)->freefunc(port_pvid);
+                                               continue;
+                                      }
+
+                                       else if (strstr(port_name, "gretap") )
+                                       {
+                                              vlan_hal_addInterface(brg_name,port_name,port_pvid);
+                                               ((CCSP_MESSAGE_BUS_INFO *)bus_handle)->freefunc(port_name);
+                                               ((CCSP_MESSAGE_BUS_INFO *)bus_handle)->freefunc(port_pvid);
+                                               continue;
+                                      }
+                                      ((CCSP_MESSAGE_BUS_INFO *)bus_handle)->freefunc(port_name);
+                                      ((CCSP_MESSAGE_BUS_INFO *)bus_handle)->freefunc(port_pvid);
+                             }
+                      }
+                      ((CCSP_MESSAGE_BUS_INFO *)bus_handle)->freefunc(brg_name);
+              }
+       }
+       return ANSC_STATUS_SUCCESS;
+_Psm_Get_Err:
+       AnscTraceFlow(("%s: cannot find %s\n",__FUNCTION__,param_name));
+       return ANSC_STATUS_FAILURE;
+
