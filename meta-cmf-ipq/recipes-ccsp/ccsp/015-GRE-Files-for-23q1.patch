+/**********************************************************************
+
+    caller:     owner of this object
+
+    prototype:
+
+        ULONG
+        GRETunnel_DelEntry
+            (
+                ANSC_HANDLE                 hInsContext,
+                ANSC_HANDLE                 hInstance
+            );
+
+    description:
+
