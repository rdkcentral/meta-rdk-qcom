Commit ID: 44d1a28fa119840524e420c49fe173308811e2a4
From: prasp <prasp@qti.qualcomm.com>
Date: Sat Aug 24 04:47:18 2024 +0530
Subject: [recipes-ccsp]: Fix for spatial streams value not updated for connected client devices
Signed-off-by: prasp <prasp@qti.qualcomm.com>

---

diff --git a/source/TR-181/sbapi/wifi_monitor.c b/source/TR-181/sbapi/wifi_monitor.c
index c972778..b13f482 100644
--- a/source/TR-181/sbapi/wifi_monitor.c
+++ b/source/TR-181/sbapi/wifi_monitor.c
@@ -7210,6 +7210,8 @@ int monitor_apis_param_send(int index, PCOSA_DML_WIFI_AP_ASSOC_DEVICE pWifiApDev
     sta_key_t sta_key;
     sta_data_t *sta = NULL;
     hash_map_t *sta_map = NULL;
+    char *key = NULL;
+    int ret = 0;
 
     #ifdef WIFI_HAL_VERSION_3
     if (pWifiApDev == NULL || (index < 0 || index >= (int)getTotalNumberVAPs())) {
@@ -7229,14 +7231,21 @@ int monitor_apis_param_send(int index, PCOSA_DML_WIFI_AP_ASSOC_DEVICE pWifiApDev
         return RETURN_ERR;
     }
 
-    sta = (sta_data_t *)hash_map_get(sta_map, to_sta_key(pWifiApDev->MacAddress, sta_key));
+    //Converting Mac byte to mac string
+    key = to_sta_key(pWifiApDev->MacAddress, sta_key);
 
-    if (sta == NULL) {
-        CcspWifiTrace(("RDK_LOG_ERROR, %s sta NULL, hash_map_get returned NULL\n", __FUNCTION__));
-        return RETURN_ERR;
+    sta = (sta_data_t *) malloc (sizeof(sta_data_t));
+    memset(sta, 0, sizeof(sta_data_t));
+
+    // Fetching Spatial streams for connected client
+    ret = wifi_getApAssociatedDeviceCapableSpatialStream(index, key, &(sta->cli_CapableNumSpatialStreams));
+    if (ret == RETURN_OK)
+    {
+       pWifiApDev->CapableNumSpatialStreams = (unsigned int)sta->cli_CapableNumSpatialStreams;
     }
 
-    pWifiApDev->CapableNumSpatialStreams = sta->cli_CapableNumSpatialStreams;
+    free(sta);
+    sta = NULL;
 
     return RETURN_OK;
 }
