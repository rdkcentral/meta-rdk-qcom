+
+**********************************************************************/
+ULONG
+CreateVAP_Commit
+    (
+        ANSC_HANDLE                 hInsContext
+    )
+{
+	CcspTraceInfo(("\n inside CreateVAP_Commit"));
+	PCOSA_DML_WIFI_CREATE_VAP_CFG       pCreateVap  = (PCOSA_DML_WIFI_CREATE_VAP_CFG)hInsContext;
+	CcspTraceInfo(("\n value sent: %s", pCreateVap->VAP_Ids));
+	if (CosaDmlWiFi_setCreateVAP(pCreateVap) == ANSC_STATUS_SUCCESS)
+	{
+		return ANSC_STATUS_SUCCESS;
+	}
+
+	return ANSC_STATUS_FAILURE;
+}
