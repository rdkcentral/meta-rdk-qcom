+/**********************************************************************  
+
+    caller:     owner of this object 
+
+    prototype: 
+
+        ULONG
+        CreateVAP_GetParamStringValue
+            (
+                ANSC_HANDLE                 hInsContext,
+                char*                       ParamName,
+                char*                       pValue,
+                ULONG*                      pUlSize
+            );
+
+    description:
+
+        This function is called to retrieve string parameter value; 
+
+    argument:   ANSC_HANDLE                 hInsContext,
+                The instance handle;
+
+                char*                       ParamName,
+                The parameter name;
+
+                char*                       pValue,
+                The string value buffer;
+
+                ULONG*                      pUlSize
+                The buffer of length of string value;
+                Usually size of 1023 will be used.
+                If it's not big enough, put required size here and return 1;
+
+    return:     0 if succeeded;
+                1 if short of buffer size; (*pUlSize = required size)
+                -1 if not supported.
+
+**********************************************************************/
+ULONG
+CreateVAP_GetParamStringValue
+    (
+        ANSC_HANDLE                 hInsContext,
+        char*                       ParamName,
+        char*                       pValue,
+        ULONG*                      pUlSize
+    )
+{
+	CcspTraceInfo(("\nCreateVAP_GetParamStringValue"));
+	PCOSA_DML_WIFI_CREATE_VAP_CFG   pCreateVap   = (PCOSA_DML_WIFI_CREATE_VAP_CFG)hInsContext;
+	errno_t                         rc           = -1;
+
+	if( AnscEqualString(ParamName, "VAP_Id", TRUE))
+	{
+		/* collect value */
+		if ( AnscSizeOfString(pCreateVap->VAP_Ids) < *pUlSize)
+		{
+			rc = strcpy_s(pValue, *pUlSize, pCreateVap->VAP_Ids);
+			ERR_CHK(rc);
+			return 0;
+		}
+		else
+		{
+			*pUlSize = AnscSizeOfString(pCreateVap->VAP_Ids);
+			return 1;
+		}
+		return 0;
+	}
+	CcspTraceInfo(("Unsupported parameter '%s'\n", ParamName));
+	return -1;
+}
+
+/***********************************************************************  
+
+    caller:     owner of this object 
+
+    prototype: 
+
+        BOOL
+        CreateVAP_SetParamStringValue
+            (
+                ANSC_HANDLE                 hInsContext,
+                char*                       ParamName,
+                char*                       pString
+            );
+
+    description:
+
+        This function is called to set string parameter value; 
+
+    argument:   ANSC_HANDLE                 hInsContext,
+                The instance handle;
+
+                char*                       ParamName,
+                The parameter name;
+
+                char*                       pString
+                The updated string value;
+
+    return:     TRUE if succeeded.
+
+**********************************************************************/
+BOOL
+CreateVAP_SetParamStringValue
+    (
+        ANSC_HANDLE                 hInsContext,
+        char*                       ParamName,
+        char*                       pString
+    )
+{    
+	CcspTraceInfo(("\n CreateVAP_SetParamStringValue inside"));
+	PCOSA_DML_WIFI_CREATE_VAP_CFG   pCreateVap   = (PCOSA_DML_WIFI_CREATE_VAP_CFG)hInsContext;
+	errno_t                         rc           = -1;
+
+	// check the parameter name and return the corresponding value 
+	if( AnscEqualString(ParamName, "VAP_Id", TRUE))
+	{
+		//collect value
+		rc = strcpy_s(pCreateVap->VAP_Ids, sizeof(pCreateVap->VAP_Ids), pString);
+		ERR_CHK(rc);
+		if(rc != EOK)
+		{
+			ERR_CHK(rc);
+			CcspTraceInfo(("\n CreateVAP_SetParamStringValue failed set"));
+			return FALSE;
+		}
+		CcspTraceInfo(("\n CreateVAP_SetParamStringValue sucessfull value : %s ", pCreateVap->VAP_Ids));
+		return TRUE;
+	}
+
+	CcspTraceWarning(("Unsupported parameter '%s'\n", ParamName));
+	return FALSE;
+}
+
+/**********************************************************************  
+
+    caller:     owner of this object 
+
+    prototype: 
+
+        BOOL
+        CreateVAP_Validate
+            (
+                ANSC_HANDLE                 hInsContext,
+                char*                       pReturnParamName,
+                ULONG*                      puLength
+            );
+
+    description:
+
+        This function is called to finally commit all the update.
+
+    argument:   ANSC_HANDLE                 hInsContext,
+                The instance handle;
+
+                char*                       pReturnParamName,
+                The buffer (128 bytes) of parameter name if there's a validation. 
+
+                ULONG*                      puLength
+                The output length of the param name. 
+
+    return:     TRUE if there's no validation.
+
+**********************************************************************/
+BOOL
+CreateVAP_Validate
+    (
+        ANSC_HANDLE                 hInsContext,
+        char*                       pReturnParamName,
+        ULONG*                      puLength
+    )
+{
+	PCOSA_DML_WIFI_CREATE_VAP_CFG   pCreateVap    = (PCOSA_DML_WIFI_CREATE_VAP_CFG)hInsContext;
+	errno_t                         rc            = -1;
+	CcspTraceInfo(("\n CreateVAP_Validate Value received: %s", pCreateVap->VAP_Ids));
+	/*VAP_Id should be non-empty*/
+	if (AnscSizeOfString(pCreateVap->VAP_Ids) == 0)
+	{
+		rc = strcpy_s(pReturnParamName, *puLength, "VAP_Id");
+		ERR_CHK(rc);
+		*puLength = AnscSizeOfString("VAP_Id");
+		CcspTraceInfo(("\n CreateVAP_Validate Failed %d ", __LINE__));
+		return FALSE;
+	}
+	char VAP[128];
+	char *saveptr;
+	memset(VAP, 0, sizeof(VAP));
+	strcpy_s(VAP, sizeof(VAP), pCreateVap->VAP_Ids);    
+	char *pt = strtok_r(VAP, ",", &saveptr);
+	while (pt != NULL)
+	{
+		int apIndex = atoi(pt)-1;
+		CcspTraceInfo(("\n split values %d ", apIndex));
+		if (apIndex < MIN_ADDITIONAL_VAP_IDX || apIndex > MAX_ADDITIONAL_VAP_IDX)
+		{
+			CcspTraceInfo(("\n CreateVAP_Validate Failed %d ", __LINE__));
+			return FALSE;
+		}
+		CcspTraceInfo(("\n CreateVAP_Validate Success"));
+		pt = strtok_r(NULL, ",", &saveptr);
+	}
+	CcspTraceInfo(("\n CreateVAP_Validate Value sent: %s", pCreateVap->VAP_Ids));
+	return TRUE;
+}
+
