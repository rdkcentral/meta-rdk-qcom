+ANSC_STATUS CosaDmlWiFi_setDeleteVAP(PCOSA_DML_WIFI_DELETE_VAP_CFG pCfg)
+{
+	CcspTraceInfo(("\nCosaDmlWiFi_setDeleteVAP value : %s ", pCfg->VAP_Ids));
+	char VAP[128];
+	char *saveptr;
+	int ret;
+	memset(VAP, 0, sizeof(VAP));
+	strcpy_s(VAP, sizeof(VAP), pCfg->VAP_Ids);
+	char *pt = strtok_r(VAP, ",", &saveptr);
+	while (pt != NULL) 
+	{
+		int apIndex = atoi(pt)-1;
+		CcspTraceInfo(("\nsplit values %d ", apIndex));
+		ret = wifi_deleteDynamicVAP(apIndex);
+		if(ret == RETURN_ERR)
+		{
+			return ANSC_STATUS_FAILURE;
+		}
+		if(CosaDmlWiFi_DelSsidApAdditionalVap(apIndex) == ANSC_STATUS_FAILURE)
+		{
+			CcspTraceInfo(("\nCosaDmlWiFi_setDeleteVAP : CosaDmlWiFi_DelSsidApAdditionalVap Error"));
+			return ANSC_STATUS_FAILURE;
+		}
+		CcspTraceInfo(("\nCosaDmlWiFi_setDeleteVAP : CosaDmlWiFi_DelSsidAdditionalVap success"));
+		pt = strtok_r(NULL, ",", &saveptr);
+	}
+
+	CcspTraceInfo(("\nCosaDmlWiFi_setDeleteVAP returns success %d ", __LINE__));
+	return ANSC_STATUS_SUCCESS;
+}
