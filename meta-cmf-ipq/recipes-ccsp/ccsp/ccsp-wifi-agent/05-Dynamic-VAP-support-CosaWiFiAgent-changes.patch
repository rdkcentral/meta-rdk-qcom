+ANSC_STATUS CosaDmlWiFi_setCreateVAP(PCOSA_DML_WIFI_CREATE_VAP_CFG pCfg)
+{
+	CcspTraceInfo(("\nCosaDmlWiFi_setCreateVAP value : %s ", pCfg->VAP_Ids));
+	char VAP[128];
+	int ret;
+	int radioIndex = 0;
+	char *saveptr;
+	wifi_vap_info_t *vapInfo = (wifi_vap_info_t *) malloc(sizeof(wifi_vap_info_t));
+	wifi_vap_info_map_t tmpWifiVapInfoMap;
+	bool isVapChanged = FALSE;
+	int vapArrayIndex = 0;
+	int tempArrayIndex = 0;
+	memset(&tmpWifiVapInfoMap, 0, sizeof(wifi_vap_info_map_t));
+	memset(VAP, 0, sizeof(VAP));
+	strcpy_s(VAP, sizeof(VAP), pCfg->VAP_Ids);
+	char *pt = strtok_r(VAP, ",", &saveptr);
+	while (pt != NULL)
+	{
+		UINT apIndex = atoi(pt)-1;
+		CcspTraceInfo(("\nsplit values %d ", apIndex));
+		ret = wifi_createDynamicVAP(apIndex);
+		if(ret == RETURN_ERR)
+		{
+			return ANSC_STATUS_FAILURE;
+		}
+		vapInfo = getVapInfo(apIndex);
+		if(!vapInfo)
+		{
+			CcspTraceInfo(("\n%s :getvapInfo Failed\n", __func__));
+			return ANSC_STATUS_FAILURE;
+		}
+		ret = qca_additionalVapInfoMap(apIndex, vapInfo);
+		if(ret == RETURN_ERR)
+		{
+			CcspTraceInfo(("\n%s : wifi_additionalVapInfoMap Failed\n", __func__));
+			return ANSC_STATUS_FAILURE;
+		}
+		radioIndex = vapInfo->radio_index;
+		vapArrayIndex = getVapArrayIndex(apIndex, radioIndex);
+		memcpy(&gRadioCfg[radioIndex].vaps.vap_array[vapArrayIndex], vapInfo, sizeof(wifi_vap_info_t));
+
+		getApPSMValues(apIndex, &isVapChanged);
+
+		memcpy(&tmpWifiVapInfoMap.vap_array[tempArrayIndex], vapInfo, sizeof(wifi_vap_info_t));
+
+		CcspTraceInfo((" %s %d vapIndex : %d is placed at vapArrayIndex : %d\n", __FUNCTION__, __LINE__, apIndex, tempArrayIndex));
+		tempArrayIndex++;
+		tmpWifiVapInfoMap.num_vaps = tempArrayIndex;
+
+		CcspTraceInfo(("\nCosaDmlWiFi_setCreateVAP : CosaDmlWiFi_SetSsidAdditionalVap Calling"));
+		//Setting AP and SSID configurations for the additional VAP apIndex
+		if (CosaDmlWiFi_SetSsidApAdditionalVap(apIndex) == ANSC_STATUS_FAILURE)
+		{
+			CcspTraceInfo(("\nCosaDmlWiFi_setCreateVAP : CosaDmlWiFi_SetSsidApAdditionalVap Error"));
+			return ANSC_STATUS_FAILURE;
+		}
+		CcspTraceInfo(("\nCosaDmlWiFi_setCreateVAP : CosaDmlWiFi_SetSsidAdditionalVap success"));
+		pt = strtok_r(NULL, ",", &saveptr);
+	}
+
+	if (isVapChanged == TRUE)
+	{
+		ccspWifiDbgPrint(CCSP_WIFI_TRACE, "%s wifi_createVAP for radioIndex:%d \n", __FUNCTION__, radioIndex);
+		ret =  wifi_createVAP(radioIndex, &tmpWifiVapInfoMap);
+		if (ret != ANSC_STATUS_SUCCESS)
+		{
+			CcspWifiTrace(("RDK_LOG_ERROR, %s wifi_createVAP returned with error %d\n", __FUNCTION__, ret));
+		}
+
+		isVapChanged = FALSE;
+		CcspWifiTrace(("RDK_LOG_INFO, %s wifi_createVAP Succesful for radioIndex:%d \n", __FUNCTION__, radioIndex));
+	}
+
+	CcspTraceInfo(("\nCosaDmlWiFi_setCreateVAP returns success %d ", __LINE__));
+	return ANSC_STATUS_SUCCESS;
+}
