Subject: issue: Transmit power fix for 6G radio Vaps
Signed-off-by: nirma <nirma@qti.qualcomm.com>

---

diff --git a/source/TR-181/ml/cosa_wifi_dml.c b/source/TR-181/ml/cosa_wifi_dml.c
index 03b3915..688be0e 100755
--- a/source/TR-181/ml/cosa_wifi_dml.c
+++ b/source/TR-181/ml/cosa_wifi_dml.c
@@ -3893,6 +3893,21 @@ Radio_SetParamIntValue
     if (strcmp(ParamName, "TransmitPower") == 0)
     {
 #ifdef WIFI_HAL_VERSION_3
+    int pwr_list[5] = {6,12,25,50,100};
+    int i = 0, is_present = 0, temp = 0;
+
+    temp = (int)iValue;
+
+    for(i = 0; i < (sizeof(pwr_list)/sizeof(pwr_list[0])); i++)
+    {
+            if(pwr_list[i] == temp) {
+                    is_present = 1;
+                    break;
+            }
+    }
+    if(is_present == 0){
+        return FALSE;
+    }
         if (wifiRadioOperParam->transmitPower == (UINT)iValue)
 #else //WIFI_HAL_VERSION_3
         if (pWifiRadioFull->Cfg.TransmitPower == iValue )
