+/***********************************************************************
+
+ APIs for Object:
+
+    WiFi.QTI_AdvFeature.{i}.
+
+    *   QTI_AdvFeature_GetEntryCount
+    *   QTI_AdvFeature_GetEntry
+    *   QTI_AdvFeature_SetParamStringValue
+
+***********************************************************************/
+
+/***********************************************************************
+
+
+    caller:     owner of this object
+
+    prototype:
+
+        ULONG
+        QTI_AdvFeature_GetEntryCount
+            (
+                ANSC_HANDLE                 hInsContext
+            );
+
+    description:
+
+        This function is called to retrieve the count of the table.
+
+    argument:   ANSC_HANDLE                 hInsContext,
+                The instance handle;
+
+    return:     The count of the table
+
+**********************************************************************/
+COSA_DML_WIFI_QTI_ADV_FEATURE_CFG g_qcafeatures;
+ULONG
+QTI_AdvFeature_GetEntryCount
+    (
+        ANSC_HANDLE                 hInsContext
+    )
+{
+    ULONG                           Feature_Count    = 1;
+    UNREFERENCED_PARAMETER(hInsContext);
+    return Feature_Count;
+}
+/**********************************************************************
+
+    caller:     owner of this object
+
+    prototype:
+
+        ANSC_HANDLE
+                QTI_AdvFeature_GetEntry
+            (
+                ANSC_HANDLE                 hInsContext,
+                ULONG                       nIndex,
+                ULONG*                      pInsNumber
+            );
+
+    description:
+
+        This function is called to retrieve the entry specified by the index.
+
+    argument:   ANSC_HANDLE                 hInsContext,
+                The instance handle;
+
+                ULONG                       nIndex,
+                The index of this entry;
+
+                ULONG*                      pInsNumber
+                The output instance number;
+
+    return:     The handle to identify the entry
+
+**********************************************************************/
+ANSC_HANDLE
+QTI_AdvFeature_GetEntry
+    (
+     ANSC_HANDLE                 hInsContext,
+     ULONG                       nIndex,
+     ULONG*                      pInsNumber
+    )
+{
+
+       CcspTraceInfo(("\n QTI_AdvFeature_GetEntry nIndex: %lu, pInsNumber: %lu ", nIndex, *pInsNumber));
+       UNREFERENCED_PARAMETER(hInsContext);
+       *pInsNumber = 1;
+       return &g_createvap_cfg; /* return the handle */
+}
+
+/**********************************************************************
+
+    caller:     owner of this object
+
+    prototype:
+
+        BOOL
+        QTI_AdvFeature_SetParamStringValue
+            (
+                ANSC_HANDLE                 hInsContext,
+                char*                       ParamName,
+                char*                       pString
+            );
+
+    description:
+
+        This function is called to set string parameter value;
+
+    argument:   ANSC_HANDLE                 hInsContext,
+                The instance handle;
+
+                char*                       ParamName,
+                The parameter name;
+
+                char*                       pString
+                The updated string value;
+
+    return:     TRUE if succeeded.
+
+**********************************************************************/
+
+
+BOOL
+QTI_AdvFeature_SetParamStringValue
+    (
+        ANSC_HANDLE                 hInsContext,
+        char*                       ParamName,
+        char*                       pString
+    )
+{
+	int ret =0;
+	PCOSA_DML_WIFI_QTI_ADV_FEATURE_CFG pFeature = (PCOSA_DML_WIFI_QTI_ADV_FEATURE_CFG)hInsContext;
+	errno_t                         rc            = -1;
+	// check the parameter name and return the corresponding value
+	if( AnscEqualString(ParamName, "SetConfig", TRUE))
+	{
+		//collect value
+              rc = strcpy_s(pFeature->Features, sizeof(pFeature->Features), pString);
+              ERR_CHK(rc);
+              if(rc != EOK)
+              {
+                     ERR_CHK(rc);
+                     CcspTraceInfo(("\n %s failed set",__func__));
+                     return FALSE;
+              }
+              CcspTraceInfo(("\n %s  sucessfull value : %s ",__func__, pFeature->Features));
+	      ret = qca_wifi_handle_adv_configs(pFeature->Features);
+	      if(ret != 0)
+	      {
+		      return FALSE;
+	      }
+             return TRUE;
+       }
+
+       CcspTraceWarning(("Unsupported parameter '%s'\n", ParamName));
+       return FALSE;
+}
+
 /***********************************************************************
 
  APIs for Object:
