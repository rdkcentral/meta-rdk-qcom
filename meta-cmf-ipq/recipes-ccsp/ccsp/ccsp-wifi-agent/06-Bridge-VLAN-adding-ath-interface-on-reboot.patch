+//Bridge VLAN tagging for ath interfaces
+#define DMSB_L2_PREFIX                    "dmsb.l2net."
+#define DMSB_L2_BPORT_PREFIX              "dmsb.l2net.%u.Port."
+#define DMCB_L2_BRG_INST_NAME           "dmsb.l2net.%u.Name"
+#define DMSB_L2_BPORT_INST_NAME         "dmsb.l2net.%u.Port.%u.Name"
+#define DMSB_L2_BPORT_INST_PVID         "dmsb.l2net.%u.Port.%u.Pvid"
+#define _PSM_GET_BRIDGE_NAME { \
+        _ansc_memset(param_name, 0, sizeof(param_name)); \
+        errno_t rc = -1; \
+        rc = sprintf_s(param_name, sizeof(param_name),DMCB_L2_BRG_INST_NAME,i); \
+        if(rc < EOK) { \
+           ERR_CHK(rc); \
+        } \
+        retPsmGet = PSM_Get_Record_Value2(bus_handle,g_Subsystem, param_name, NULL, &brg_name); \
+        if (retPsmGet != CCSP_SUCCESS) { \
+            goto _Psm_Get_Err;\
+        } \
+    }
+
+#define _PSM_GET_PORT_NAME { \
+        _ansc_memset(param_name, 0, sizeof(param_name)); \
+        errno_t rc = -1; \
+        rc = sprintf_s(param_name, sizeof(param_name), DMSB_L2_BPORT_INST_NAME,i,j); \
+        if(rc < EOK) { \
+           ERR_CHK(rc); \
+        } \
+        retPsmGet = PSM_Get_Record_Value2(bus_handle,g_Subsystem, param_name, NULL, &port_name); \
+        if (retPsmGet != CCSP_SUCCESS) { \
+            goto _Psm_Get_Err;\
+        } \
+    }
+#define _PSM_GET_PORT_PVID { \
+        _ansc_memset(param_name, 0, sizeof(param_name)); \
+        errno_t rc = -1; \
+        rc = sprintf_s(param_name, sizeof(param_name), DMSB_L2_BPORT_INST_PVID,i,j); \
+        if(rc < EOK) { \
+           ERR_CHK(rc); \
+        } \
+        retPsmGet = PSM_Get_Record_Value2(bus_handle,g_Subsystem, param_name, NULL, &port_pvid); \
+        if (retPsmGet != CCSP_SUCCESS) { \
+            goto _Psm_Get_Err;\
+        } \
+    }
+
