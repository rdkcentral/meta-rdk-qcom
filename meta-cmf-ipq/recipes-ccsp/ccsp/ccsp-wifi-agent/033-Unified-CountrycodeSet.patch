From: Robin Rajamony <rrajamon@qti.qualcomm.com>
Date: Mon Dec 16 13:39:36 2024 +0530
Subject: [ccsp-wifi-agent] : Set Country code for one radio should update the remaining radios.
Signed-off-by: Robin Rajamony <rrajamon@qti.qualcomm.com>
-----------------------------------

diff --git a/source/TR-181/ml/cosa_wifi_dml.c b/source/TR-181/ml/cosa_wifi_dml.c
index 119c90d..564eb42 100755
--- a/source/TR-181/ml/cosa_wifi_dml.c
+++ b/source/TR-181/ml/cosa_wifi_dml.c
@@ -4818,14 +4818,19 @@ Radio_SetParamStringValue
         char*                       pString
     )
 {
+    PCOSA_DATAMODEL_WIFI            pMyObject      = (PCOSA_DATAMODEL_WIFI)g_pCosaBEManager->hWifi;
     PCOSA_DML_WIFI_RADIO            pWifiRadio     = hInsContext;
     PCOSA_DML_WIFI_RADIO_FULL       pWifiRadioFull = &pWifiRadio->Radio;
+    PCOSA_DML_WIFI_RADIO            pWifiRadio2    = NULL;
+    PCOSA_DML_WIFI_RADIO_FULL       pWifiRadioFull2 = NULL;
     errno_t                         rc             = -1;
+    int idx;

 #ifdef WIFI_HAL_VERSION_3
     ULONG instanceNumber = pWifiRadioFull->Cfg.InstanceNumber;
     UINT wlanIndex = 0;
     wifi_radio_operationParam_t *wifiRadioOperParam = NULL;
+    wifi_radio_operationParam_t *wifiRadioOperParam1 = NULL;
     wifi_freq_bands_t tmpHalFreqBand = 0;
     wifi_ieee80211Variant_t  tmpHalWifiStd = 0;
     wifi_countrycode_type_t tmpCountryCode = 0;
@@ -5022,6 +5027,17 @@ Radio_SetParamStringValue
     if (strcmp(ParamName, "RegulatoryDomain") == 0)
     {
 #ifdef WIFI_HAL_VERSION_3
+
+        // In Global mode, 5GHz and 6GHz are down. Hence Radio Param validation is failing.
+        if (strcmp(pWifiRadioFull->Cfg.RegulatoryDomain, "00") == 0)
+        {
+            if (wlanIndex != 0)
+            {
+                CcspTraceWarning(("In Global mode 5GHz and 6GHz radios are down. Change 2.4GHz Radio CC\n"));
+                return FALSE;
+            }
+        }
+
         if (regDomainStrToEnum(pString, &tmpCountryCode) != ANSC_STATUS_SUCCESS)
         {
             return FALSE;
@@ -5034,6 +5050,27 @@ Radio_SetParamStringValue

         wifiRadioOperParam->countryCode = tmpCountryCode;
         pWifiRadioFull->Cfg.isRadioConfigChanged = TRUE;
+        for ( idx = 0; idx < pMyObject->RadioCount; idx++)
+        {
+            if (idx == wlanIndex )
+            {
+                continue;
+            }
+
+            pWifiRadio2     = pMyObject->pRadio + idx;
+            pWifiRadioFull2 = &pWifiRadio2->Radio;
+            rc = STRCPY_S_NOCLOBBER( pWifiRadioFull2->Cfg.RegulatoryDomain, sizeof(pWifiRadioFull2->Cfg.RegulatoryDomain), pString );
+            ERR_CHK(rc);
+
+           memset(&wifiRadioOperParam1, 0, sizeof(wifi_radio_operationParam_t));
+           wifiRadioOperParam1 = getRadioOperationParam(idx);
+           if (wifiRadioOperParam1 == NULL)
+           {
+               return FALSE;
+           }
+            wifiRadioOperParam1->countryCode = tmpCountryCode;
+        }
+
 #else //WIFI_HAL_VERSION_3
         if ( strcmp(pWifiRadioFull->Cfg.RegulatoryDomain, pString) == 0)
         {
