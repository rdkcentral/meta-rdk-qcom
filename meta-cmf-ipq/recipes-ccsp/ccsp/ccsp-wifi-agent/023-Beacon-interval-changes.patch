From: Sritaaman C <sriraama@qti.qualcomm.com>
Date: Mon Dec 18 19:37:50 2023 +0530
Subject: Reason for change: Fix for able to set Beacon value between 100 to 3500
Signed-off-by: Sritaaman C <sriraama@qti.qualcomm.com>

---

diff --git a/source/TR-181/ml/cosa_wifi_dml.c b/source/TR-181/ml/cosa_wifi_dml.c
index b1d2df4..49e60ea 100755
--- a/source/TR-181/ml/cosa_wifi_dml.c
+++ b/source/TR-181/ml/cosa_wifi_dml.c
@@ -4527,11 +4527,21 @@ Radio_SetParamUlongValue
         wifiRadioOperParam->beaconInterval = uValue;
         pWifiRadioFull->Cfg.isRadioConfigChanged = TRUE;
         ccspWifiDbgPrint(CCSP_WIFI_TRACE, "%s beaconInterval : %d\n", __FUNCTION__, wifiRadioOperParam->beaconInterval);
+
+	if (uValue < 100 || uValue > 3500)
+	{
+		return FALSE;
+	}
 #else //WIFI_HAL_VERSION_3
         /* save update to backup */
         pWifiRadioFull->Cfg.BeaconInterval = uValue;
         pWifiRadio->bRadioChanged = TRUE;
         CosaDmlWiFi_setRadioBeaconPeriod((pWifiRadio->Radio.Cfg.InstanceNumber - 1),uValue);
+
+	if (uValue < 100 || uValue > 3500)
+	{
+		return FALSE;
+	}
 #endif //WIFI_HAL_VERSION_3
         return TRUE;
     }
