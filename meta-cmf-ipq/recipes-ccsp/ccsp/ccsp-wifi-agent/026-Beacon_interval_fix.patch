---

diff --git a/source/TR-181/ml/cosa_wifi_dml.c b/source/TR-181/ml/cosa_wifi_dml.c
index b9af698..8c22bfc 100755
--- a/source/TR-181/ml/cosa_wifi_dml.c
+++ b/source/TR-181/ml/cosa_wifi_dml.c
@@ -5138,7 +5138,11 @@ Radio_Validate
          return FALSE;
     }

+#ifndef _PLATFORM_IPQ_
     if( pWifiRadioFull->Cfg.BeaconInterval > 65535 )
+#else
+    if( pWifiRadioFull->Cfg.BeaconInterval > 3500 ||  pWifiRadioOperParam->beaconInterval < 100)
+#endif
     {
          CcspTraceWarning(("********Radio Validate:Failed BeaconInterval\n"));
          rc = strcpy_s(pReturnParamName, *puLength, "BeaconInterval");
diff --git a/source/TR-181/sbapi/cosa_wifi_apis.c b/source/TR-181/sbapi/cosa_wifi_apis.c
index 2cc78e2..a09e74d 100644
--- a/source/TR-181/sbapi/cosa_wifi_apis.c
+++ b/source/TR-181/sbapi/cosa_wifi_apis.c
@@ -25909,7 +25909,11 @@ ANSC_STATUS wifiRadioOperParamValidation(UINT radioIndex, wifi_radio_operationPa
     ccspWifiDbgPrint(CCSP_WIFI_TRACE, "%s for RadioIndex : %d\n", __FUNCTION__, radioIndex);

     /*BeaconInterval*/
+#ifndef _PLATFORM_IPQ_
     if (pWifiRadioOperParam->beaconInterval > 65535)
+#else
+    if( pWifiRadioOperParam->beaconInterval > 3500 || pWifiRadioOperParam->beaconInterval < 100)
+#endif
     {
         CcspWifiTrace(("RDK_LOG_ERROR, %s Failed for  BeaconInterval : %d for RadioIndex %d\n", __FUNCTION__, pWifiRadioOperParam->beaconInterval, radioIndex));
         return ANSC_STATUS_FAILURE;
