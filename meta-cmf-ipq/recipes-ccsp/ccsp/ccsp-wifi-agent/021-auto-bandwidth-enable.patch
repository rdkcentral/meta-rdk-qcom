Subject: [recipes-ccsp] Auto Bandwidth enabled
Signed-off-by: Sriraaman C <sriraama@qti.qualcomm.com>

---

diff --git a/source/TR-181/sbapi/cosa_wifi_apis.c b/source/TR-181/sbapi/cosa_wifi_apis.c
index 41d480e..034e4b2 100644
--- a/source/TR-181/sbapi/cosa_wifi_apis.c
+++ b/source/TR-181/sbapi/cosa_wifi_apis.c
@@ -2104,6 +2104,7 @@ struct  wifiStdCosaHalMap wifiStdMap[] =
 
 struct wifiChanWidthCosaHalMap wifiChanWidthMap[] =
 {
+    {WIFI_CHANNELBANDWIDTH_AUTO,     COSA_DML_WIFI_CHAN_BW_AUTO,   "Auto"},
     {WIFI_CHANNELBANDWIDTH_20MHZ,    COSA_DML_WIFI_CHAN_BW_20M,    "20MHz"},
     {WIFI_CHANNELBANDWIDTH_40MHZ,    COSA_DML_WIFI_CHAN_BW_40M,    "40MHz"},
     {WIFI_CHANNELBANDWIDTH_80MHZ,    COSA_DML_WIFI_CHAN_BW_80M,    "80MHz"},
@@ -12616,7 +12617,7 @@ int CosaDmlSetRadioMode(PCOSA_DML_WIFI_RADIO_CFG pCfg, int wlanIndex)
 			else{
 				chnMode = "11NAHT20";
 			}
-		} else if (pCfg->OperatingChannelBandwidth & COSA_DML_WIFI_CHAN_BW_40M)
+		} else if (pCfg->OperatingChannelBandwidth & COSA_DML_WIFI_CHAN_BW_40M || pCfg->OperatingChannelBandwidth == COSA_DML_WIFI_CHAN_BW_AUTO)
 		{
 			// treat 40 and Auto as 40MHz, the driver does not have an 'Auto setting' that can be toggled
 
@@ -12653,7 +12654,7 @@ int CosaDmlSetRadioMode(PCOSA_DML_WIFI_RADIO_CFG pCfg, int wlanIndex)
 		} else if (pCfg->OperatingChannelBandwidth == COSA_DML_WIFI_CHAN_BW_80M)
 		{
 			chnMode = "11ACVHT80";
-		}else if (pCfg->OperatingChannelBandwidth == COSA_DML_WIFI_CHAN_BW_160M)
+		}else if (pCfg->OperatingChannelBandwidth == COSA_DML_WIFI_CHAN_BW_160M || pCfg->OperatingChannelBandwidth == COSA_DML_WIFI_CHAN_BW_AUTO)
 		{
 			chnMode = "11ACVHT160";
 		}
@@ -12681,6 +12682,15 @@ int CosaDmlSetRadioMode(PCOSA_DML_WIFI_RADIO_CFG pCfg, int wlanIndex)
 		{
 			chnMode = "11AXHE160";
 		}
+		else if (pCfg->OperatingChannelBandwidth == COSA_DML_WIFI_CHAN_BW_AUTO)
+		{
+			if (wlanIndex == 0)
+				chnMode = "11GHE40";
+			if (wlanIndex == 1)
+				chnMode = "11AHE160";
+			if (wlanIndex == 2)
+				chnMode = "11AHE160";
+		}
 
 	}
         else if (pCfg->OperatingStandards & COSA_DML_WIFI_STD_be)
@@ -12712,6 +12722,15 @@ int CosaDmlSetRadioMode(PCOSA_DML_WIFI_RADIO_CFG pCfg, int wlanIndex)
                    {
                        chnMode = "11BEHT320";
                    }
+	      else if (pCfg->OperatingChannelBandwidth == COSA_DML_WIFI_CHAN_BW_AUTO)
+	      {
+		      if (wlanIndex == 0)
+			      chnMode = "11GEHT40";
+		      if (wlanIndex == 1)
+			      chnMode = "11AEHT160";
+		      if (wlanIndex == 2)
+			      chnMode = "11AEHT320";
+	      }
         }
 
 	// if OperatingStandards is set to only g or only n, set only flag to TRUE.
