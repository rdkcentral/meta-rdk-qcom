+#define DEBUG_INI      "/etc/debug.ini"
+#define LOGLEVELS_MAX  5
+#define BUFSIZE        1024
+#define LEVELSTR_SIZE  256
+#include "logagent.h"
+char loglevel_map[LOGLEVELS_MAX][LEVELSTR_SIZE] = {
+        "FATAL ERROR WARN",
+        "FATAL ERROR WARN NOTICE",
+        "FATAL ERROR WARN NOTICE INFO",
+        "FATAL ERROR WARN NOTICE INFO DEBUG",
+        "FATAL ERROR WARN NOTICE INFO DEBUG TRACE",
+        };
+
+
+static int _syscmd(char *cmd, char *retBuf, int retBufSize)
+{
+    FILE *f;
+    char *ptr = retBuf;
+    int bufSize=retBufSize, bufbytes=0, readbytes=0, cmd_ret=0;
+
+    if((f = popen(cmd, "r")) == NULL)
+    {
+        fprintf(stderr,"\npopen %s error\n", cmd);
+        return false;
+    }
+    while(!feof(f))
+    {
+        *ptr = 0;
+        if(bufSize>=128)
+        {
+            bufbytes=128;
+        }
+        else
+        {
+            bufbytes=bufSize-1;
+        }
+        fgets(ptr,bufbytes,f);
+        readbytes=strlen(ptr);
+        if(!readbytes)
+        {
+            break;
+        }
+        bufSize-=readbytes;
+        ptr += readbytes;
+    }
+
+
+    cmd_ret = pclose(f);
+    retBuf[retBufSize-1]=0;
+    return cmd_ret >> 8;
+}
+
+bool is_enabled(const char *component) {
+        char cmd[BUFSIZE] = {0};
+        char buf[BUFSIZE] = {0};
+	char syscfg_buf[BUFSIZE] = {0};
+	char syscfg_component_string[BUFSIZE] = {0};
+
+
+	if(!strcmp("WIFI",component)) {
+		component = "WiFi";
+	}
+
+	if(!strcmp("ETHAGENT",component)) {
+		component = "EthAgent";
+	}
+
+       snprintf(cmd, sizeof(cmd), "grep -E -i '^LOG.RDK.%s' %s", component, DEBUG_INI);
+	snprintf(syscfg_component_string, sizeof(syscfg_component_string), "X_RDKCENTRAL-COM_%s_LoggerEnable", component);
+
+	syscfg_get( NULL, syscfg_component_string, syscfg_buf, sizeof(syscfg_buf));
+
+
+	if (atoi(syscfg_buf) == 0) {
+		
+		return false;
+	}
+
+	if (_syscmd(cmd, buf, sizeof(buf)) != 0) {
+	
+		return false;
+	}
+
+	
+	return true;
+}
+
+void enable_disable(const char *component, bool loggerenabled) {
+        char cmd[BUFSIZE] = {0};
+        char buf[BUFSIZE] = {0};
+
+	
+        if (is_enabled(component) && !loggerenabled) {
+                snprintf(cmd, sizeof(cmd), "sed -i 's/^LOG.RDK.%s/#LOG.RDK.%s/g' %s", component, component, DEBUG_INI);
+                _syscmd(cmd, buf, sizeof(buf));
+  	 }
+
+        if (!is_enabled(component) && loggerenabled) {
+                snprintf(cmd, sizeof(cmd), "sed -i 's/^#LOG.RDK.%s/LOG.RDK.%s/g' %s", component, component, DEBUG_INI);
+                _syscmd(cmd, buf, sizeof(buf));
+        }
+}
+bool loglevel_update(const char *component, uint32_t loggerlevel) {
+        char cmd[BUFSIZE] = {0};
+        char buf[BUFSIZE] = {0};
+
+        if (is_enabled(component)) {
+                if (loggerlevel >= LOGLEVELS_MAX) {
+                        loggerlevel = LOGLEVELS_MAX - 1;
+                }
+                snprintf(cmd, sizeof(cmd), "sed -i 's/^LOG.RDK.%s = .*/LOG.RDK.%s = %s/g' %s", component, component, loglevel_map[loggerlevel], DEBUG_INI);
+        } else {
+                return false;
+        }
+
+        _syscmd(cmd, buf, sizeof(cmd));
+        return true;
+}
