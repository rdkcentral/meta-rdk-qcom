+ULONG
+RemoteProc_GetEntryCount
+    (
+        ANSC_HANDLE                 hInsContext
+    )
+{
+    DIR           *dir;
+    struct dirent *entry;
+    int            count = 0;
+
+    dir = opendir("/sys/class/remoteproc");
+    if (dir == NULL)
+    {
+        return 0;
+    }
+
+    while ((entry = readdir(dir)) != NULL)
+    {
+        /* Count only entries named "remoteproc0", "remoteproc1", etc. */
+        if (strncmp(entry->d_name, "remoteproc", 10) == 0)
+            count++;
+    }
+
+    closedir(dir);
+
+    return (ULONG)count;
+}
+
+/**
+ * RemoteProc_GetEntry
+ * Returns context handle for each instance.
+ * Instance number (1-based) is stored as context.
+ * instance=1 → remoteproc0, instance=2 → remoteproc1
+ */
+ANSC_HANDLE
+RemoteProc_GetEntry
+    (
+        ANSC_HANDLE                 hInsContext,
+        ULONG                       nIndex,
+        ULONG*                      pInsNumber
+    )
+{
+    char path[64];
+    snprintf(path, sizeof(path),
+             "/sys/class/remoteproc/remoteproc%lu", nIndex);
+
+    if (access(path, F_OK) != 0)
+        return NULL;
+
+    *pInsNumber = nIndex + 1;
+    return (ANSC_HANDLE)(uintptr_t)(nIndex + 1);
+}
+
+/**
+ * RemoteProc_GetParamBoolValue
+ * Enable: reads state from sysfs — "running"=TRUE, else FALSE
+ */
+BOOL
+RemoteProc_GetParamBoolValue
+    (
+        ANSC_HANDLE                 hInsContext,
+        char*                       ParamName,
+        BOOL*                       pBool
+    )
+{
+    int   instance = (int)(uintptr_t)hInsContext;
+    int   idx      = instance - 1;
+    char  path[64];
+    char  buf[32]  = {0};
+    FILE *fp;
+
+    if (AnscEqualString(ParamName, "Enable", TRUE))
+    {
+        snprintf(path, sizeof(path),
+                 "/sys/class/remoteproc/remoteproc%d/state", idx);
+
+        fp = fopen(path, "r");
+        if (fp)
+        {
+            fgets(buf, sizeof(buf), fp);
+            fclose(fp);
+        }
+
+        *pBool = (strncmp(buf, "running", 7) == 0) ? TRUE : FALSE;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+/**
+ * RemoteProc_GetParamStringValue
+ * Status: reads state from sysfs — "Running" or "Stopped"
+ */
+ULONG
+RemoteProc_GetParamStringValue
+    (
+        ANSC_HANDLE                 hInsContext,
+        char*                       ParamName,
+        char*                       pValue,
+        ULONG*                      pUlSize
+    )
+{
+    int   instance = (int)(uintptr_t)hInsContext;
+    int   idx      = instance - 1;
+    char  path[64];
+    char  buf[32]  = {0};
+    FILE *fp;
+
+    if (AnscEqualString(ParamName, "Status", TRUE))
+    {
+        snprintf(path, sizeof(path),
+                 "/sys/class/remoteproc/remoteproc%d/state", idx);
+
+        fp = fopen(path, "r");
+        if (fp)
+        {
+            fgets(buf, sizeof(buf), fp);
+            fclose(fp);
+        }
+
+        AnscCopyString(pValue,
+            (strncmp(buf, "running", 7) == 0) ? "Running" : "Stopped");
+        return 0;
+    }
+
+    return -1;
+}
+
+/**
+ * RemoteProc_SetParamBoolValue
+ * Enable: true=start, false=stop via v_secure_system
+ */
+BOOL
+RemoteProc_SetParamBoolValue
+    (
+        ANSC_HANDLE                 hInsContext,
+        char*                       ParamName,
+        BOOL                        bValue
+    )
+{
+    int   instance = (int)(uintptr_t)hInsContext;
+    int   idx      = instance - 1;
+    char  path[64] = {0};
+    FILE *fp       = NULL;
+
+    if (AnscEqualString(ParamName, "Enable", TRUE))
+    {
+        snprintf(path, sizeof(path),
+                 "/sys/class/remoteproc/remoteproc%d/state", idx);
+
+        fp = fopen(path, "w");
+        if (fp != NULL)
+        {
+            if (bValue)
+            {
+                fprintf(fp, "start");
+            }
+            else
+            {
+                fprintf(fp, "stop");
+            }
+            fclose(fp);
+        }
+        else
+        {
+            CcspTraceError(("%s - %d - Failed to set value \n", __FUNCTION__, __LINE__));
+        }
+
+        return TRUE;
+    }
+
+    return FALSE;
+}
 
