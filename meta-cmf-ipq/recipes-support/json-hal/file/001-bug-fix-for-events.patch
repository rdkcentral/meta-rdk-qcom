From: sreehari ramanjula <sramanju@qti.qualcomm.com>
Date: Sat Aug 31 12:15:44 2024 +0530
Subject: json-hal-lib:Handle the synchronization between data models
Signed-off-by: sreehari ramanjula <sramanju@qti.qualcomm.com>

---

diff --git a/json_hal_client.c b/json_hal_client.c
index f39d5d8..af2e2fe 100644
--- a/json_hal_client.c
+++ b/json_hal_client.c
@@ -34,6 +34,8 @@
 //Ticker timeout for aprox. 10s (40 x 250ms)
 #define SEND_MSG_TICKER_TIMEOUT         40
 
+int ijsonrpcbug = 0;
+int ijsonrpcbuginevent = 0;
 
 /* global variable to keep connection state. */
 static int g_connected = FALSE;
@@ -423,6 +425,13 @@ static int response_parse_cb(const int fd, const char *buffer, const int len)
                             char event_name[BUF_512] = { '\0' };
                             strncpy(event_name, json_object_get_string(jevent_msg_param_val), sizeof(event_name));
                             LOGINFO("Event name = %s", event_name);
+                            if (ijsonrpcbug==1)
+                            {
+			       LOGINFO("Bug in JSON RPC code:ijsonrpcbug=1:skipping received event %s\n", event_name);
+                               json_object_put(jobj);
+                               json_tokener_free(tok);
+                               return RETURN_OK;
+                            }
                             event_tracking_t* events = NULL;
                             pthread_mutex_lock(&gm_event_tracking_lock);
                             LL_FOREACH(g_event_tracking, events)
@@ -437,6 +446,7 @@ static int response_parse_cb(const int fd, const char *buffer, const int len)
 #ifdef DEBUG_ENABLED
                                         LOGINFO("Event Msg = %s \n", event_buf);
 #endif
+					ijsonrpcbuginevent=1;
                                         events->event_cb(event_buf, event_buf_len);
                                         event_buf = NULL; // reset buffer.
 
@@ -494,6 +504,7 @@ static int response_parse_cb(const int fd, const char *buffer, const int len)
                     * and if a matching id found, fill its buffer with response
                     * and send the msg_rcd signal.
                     */
+		    ijsonrpcbuginevent=0;
                     pthread_mutex_lock(&gm_request_msg_tracking_lock);
                     request_msg_tracking_t* tmp, * rpc;
                     LL_FOREACH_SAFE(g_request_msg_tracking, rpc, tmp)
@@ -680,11 +691,13 @@ static int client_send_and_get_reply(const json_object *jrequest_msg, int tick_t
      * msg_rcvd signal will be sent by the thread receiving the messages 
      * or after the message timeout.
      */
+    ijsonrpcbug=1;
     pthread_cond_wait(&rpc->msg_rcvd, &rpc->lock);
     pthread_mutex_unlock(&rpc->lock);
     pthread_mutex_destroy(&rpc->lock);
     pthread_cond_destroy(&rpc->msg_rcvd);
     request_delete_cb(request_msg_req_id);
+    ijsonrpcbug=0;
 
     rc = rpc->rc;
     /* Got response and fill it back for requester. */
diff --git a/json_hal_client.h b/json_hal_client.h
index f1e2421..b8f9b7b 100644
--- a/json_hal_client.h
+++ b/json_hal_client.h
@@ -41,6 +41,9 @@
 
 #define BUF_512 512
 
+extern int ijsonrpcbug;
+extern int ijsonrpcbuginevent;
+
 /**
  * @brief Typedefed event callback handler routine.
  * @param (IN) Buffer pointing to the event message
diff --git a/json_hal_client.c b/json_hal_client.c
index f39d5d8..2c1214d 100644
--- a/json_hal_client.c
+++ b/json_hal_client.c
@@ -659,7 +659,7 @@ static int client_send_and_get_reply(const json_object *jrequest_msg, int tick_t
     rpc->sequence = request_msg_req_id;

     //Timeout period.
-    rpc->ticker = tick_timeout;
+    rpc->ticker = 3*tick_timeout;
     rpc->rc = RETURN_ERR;

     LL_APPEND(g_request_msg_tracking, rpc);

